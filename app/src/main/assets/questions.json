[
  {"id":"s_phy_kin_1","domain":"PHYSICS","text":"Displacement is the shortest straight-line distance between start and end?","options":[{"id":1,"text":"True - displacement is the vector shortest path","isCorrect":true},{"id":2,"text":"False - displacement is total distance travelled","isCorrect":false},{"id":3,"text":"Speed is the shortest distance","isCorrect":false},{"id":4,"text":"Velocity is total distance travelled","isCorrect":false}],"explanation":"Displacement is straight-line change in position; distance is total ground covered.","difficulty":"BASIC"},
  {"id":"s_phy_kin_2","domain":"PHYSICS","text":"The area under a velocity-time graph gives?","options":[{"id":1,"text":"Displacement of the object","isCorrect":true},{"id":2,"text":"Acceleration of the object","isCorrect":false},{"id":3,"text":"Force acting on the object","isCorrect":false},{"id":4,"text":"Mass of the object","isCorrect":false}],"explanation":"Area under v-t graph equals displacement.","difficulty":"BASIC"},
  {"id":"s_phy_new_1","domain":"PHYSICS","text":"Newton's First Law is also known as the Law of Inertia?","options":[{"id":1,"text":"True - objects resist change in motion","isCorrect":true},{"id":2,"text":"False - First Law is action-reaction","isCorrect":false},{"id":3,"text":"Inertia belongs to the Third Law","isCorrect":false},{"id":4,"text":"First Law is about energy","isCorrect":false}],"explanation":"Inertia is the tendency to resist motion change.","difficulty":"BASIC"},
  {"id":"s_phy_new_2","domain":"PHYSICS","text":"From F = ma, doubling the mass at constant force does what to acceleration?","options":[{"id":1,"text":"Halves it","isCorrect":true},{"id":2,"text":"Doubles it","isCorrect":false},{"id":3,"text":"Leaves it unchanged","isCorrect":false},{"id":4,"text":"Makes it zero","isCorrect":false}],"explanation":"a = F/m, so double mass means half acceleration.","difficulty":"INTERMEDIATE"},
  {"id":"s_phy_ene_1","domain":"PHYSICS","text":"Pushing hard against a wall without moving it is zero work in physics?","options":[{"id":1,"text":"True - no displacement means no work","isCorrect":true},{"id":2,"text":"False - effort always counts as work","isCorrect":false},{"id":3,"text":"True only for heavy walls","isCorrect":false},{"id":4,"text":"False - heat is produced so work is done","isCorrect":false}],"explanation":"Work needs force AND displacement.","difficulty":"BASIC"},
  {"id":"s_phy_ene_2","domain":"PHYSICS","text":"Which energy does a stretched rubber band store?","options":[{"id":1,"text":"Potential energy","isCorrect":true},{"id":2,"text":"Kinetic energy","isCorrect":false},{"id":3,"text":"Thermal energy","isCorrect":false},{"id":4,"text":"Nuclear energy","isCorrect":false}],"explanation":"Stretched band stores potential energy, released as kinetic.","difficulty":"BASIC"},
  {"id":"s_phy_lig_1","domain":"PHYSICS","text":"According to the Law of Reflection, angle of incidence equals angle of reflection?","options":[{"id":1,"text":"True - mirror images depend on it","isCorrect":true},{"id":2,"text":"False - reflection doubles the angle","isCorrect":false},{"id":3,"text":"True only for concave mirrors","isCorrect":false},{"id":4,"text":"False - refraction governs mirrors","isCorrect":false}],"explanation":"Flat mirrors image you because angles match.","difficulty":"BASIC"},
  {"id":"s_phy_lig_2","domain":"PHYSICS","text":"A convex mirror is used in parking lots because it?","options":[{"id":1,"text":"Spreads light for a wider view","isCorrect":true},{"id":2,"text":"Focuses light to a point","isCorrect":false},{"id":3,"text":"Absorbs all incident light","isCorrect":false},{"id":4,"text":"Shows true-size images","isCorrect":false}],"explanation":"Bulging mirrors shrink images and widen view.","difficulty":"BASIC"},
  {"id":"s_phy_hea_1","domain":"PHYSICS","text":"Heat travels through a metal spoon mainly by conduction?","options":[{"id":1,"text":"Conduction - particle collisions","isCorrect":true},{"id":2,"text":"Convection - fluid flow","isCorrect":false},{"id":3,"text":"Radiation - vacuum waves","isCorrect":false},{"id":4,"text":"Evaporation - liquid to gas","isCorrect":false}],"explanation":"Metals conduct via particle collisions.","difficulty":"BASIC"},
  {"id":"s_phy_hea_2","domain":"PHYSICS","text":"Radiation is the only way heat crosses the vacuum of space?","options":[{"id":1,"text":"True - no particles for conduction","isCorrect":true},{"id":2,"text":"False - convection works in vacuum","isCorrect":false},{"id":3,"text":"False - conduction works in vacuum","isCorrect":false},{"id":4,"text":"True only at night","isCorrect":false}],"explanation":"Sunlight reaches Earth as electromagnetic waves.","difficulty":"INTERMEDIATE"},
  {"id":"s_phy_wav_1","domain":"PHYSICS","text":"Transverse waves vibrate perpendicular to energy travel?","options":[{"id":1,"text":"True - like light and guitar strings","isCorrect":true},{"id":2,"text":"False - that describes sound","isCorrect":false},{"id":3,"text":"True only in water","isCorrect":false},{"id":4,"text":"False - no such waves exist","isCorrect":false}],"explanation":"Light is transverse; sound is longitudinal.","difficulty":"BASIC"},
  {"id":"s_phy_wav_2","domain":"PHYSICS","text":"Sound waves create compressions and rarefactions?","options":[{"id":1,"text":"True - longitudinal vibration pattern","isCorrect":true},{"id":2,"text":"False - sound is transverse","isCorrect":false},{"id":3,"text":"True only underwater","isCorrect":false},{"id":4,"text":"False - sound needs no medium pattern","isCorrect":false}],"explanation":"Particles vibrate along travel direction.","difficulty":"INTERMEDIATE"},
  {"id":"s_phy_elm_1","domain":"PHYSICS","text":"A changing magnetic field can create an electric current?","options":[{"id":1,"text":"True - electromagnetic induction","isCorrect":true},{"id":2,"text":"False - magnets only attract iron","isCorrect":false},{"id":3,"text":"True only with batteries","isCorrect":false},{"id":4,"text":"False - current needs friction","isCorrect":false}],"explanation":"Induction powers modern generators.","difficulty":"INTERMEDIATE"},
  {"id":"s_phy_elm_2","domain":"PHYSICS","text":"An electric current through a wire makes a temporary electromagnet?","options":[{"id":1,"text":"True - controllable by current","isCorrect":true},{"id":2,"text":"False - only permanent magnets exist","isCorrect":false},{"id":3,"text":"True only with iron core","isCorrect":false},{"id":4,"text":"False - current destroys magnetism","isCorrect":false}],"explanation":"Current strength controls magnet strength.","difficulty":"BASIC"},
  {"id":"s_phy_nuc_1","domain":"PHYSICS","text":"Splitting a heavy nucleus like uranium is called?","options":[{"id":1,"text":"Fission","isCorrect":true},{"id":2,"text":"Fusion","isCorrect":false},{"id":3,"text":"Radioactivity","isCorrect":false},{"id":4,"text":"Ionization","isCorrect":false}],"explanation":"Fission splits heavy nuclei; fusion joins light ones.","difficulty":"INTERMEDIATE"},
  {"id":"s_phy_nuc_2","domain":"PHYSICS","text":"What powers the Sun and stars?","options":[{"id":1,"text":"Nuclear fusion of hydrogen","isCorrect":true},{"id":2,"text":"Chemical burning of coal","isCorrect":false},{"id":3,"text":"Nuclear fission of uranium","isCorrect":false},{"id":4,"text":"Geothermal heat","isCorrect":false}],"explanation":"Fusion joins light nuclei, releasing starlight.","difficulty":"ADVANCED"},
  {"id":"s_phy_flu_1","domain":"PHYSICS","text":"Bernoulli's principle says fast-moving fluids exert?","options":[{"id":1,"text":"Less pressure - how wings lift","isCorrect":true},{"id":2,"text":"More pressure - pushing wings down","isCorrect":false},{"id":3,"text":"Zero pressure always","isCorrect":false},{"id":4,"text":"Constant pressure regardless","isCorrect":false}],"explanation":"Fast airflow means lower pressure above wings.","difficulty":"INTERMEDIATE"},
  {"id":"s_phy_the_1","domain":"PHYSICS","text":"The second law of thermodynamics says entropy of an isolated system?","options":[{"id":1,"text":"Always increases","isCorrect":true},{"id":2,"text":"Always decreases","isCorrect":false},{"id":3,"text":"Stays exactly constant","isCorrect":false},{"id":4,"text":"Becomes zero","isCorrect":false}],"explanation":"Disorder grows; heat flows hot to cold.","difficulty":"ADVANCED"},
  {"id":"s_phy_opt_1","domain":"PHYSICS","text":"Total internal reflection keeps internet signals inside fiber-optic cables?","options":[{"id":1,"text":"True - light stays trapped inside","isCorrect":true},{"id":2,"text":"False - fiber uses copper wires","isCorrect":false},{"id":3,"text":"True only at night","isCorrect":false},{"id":4,"text":"False - signals travel outside","isCorrect":false}],"explanation":"Trapped light carries data across oceans.","difficulty":"INTERMEDIATE"},
  {"id":"s_phy_mod_1","domain":"PHYSICS","text":"E = mc^2 expresses that mass is?","options":[{"id":1,"text":"Frozen energy","isCorrect":true},{"id":2,"text":"Unrelated to energy","isCorrect":false},{"id":3,"text":"Always conserved alone","isCorrect":false},{"id":4,"text":"Heavier at night","isCorrect":false}],"explanation":"Mass-energy equivalence underpins nuclear power.","difficulty":"ADVANCED"},
  {"id":"s_che_mat_1","domain":"CHEMISTRY","text":"Gases have no fixed shape or volume because particles move freely?","options":[{"id":1,"text":"True - expand to fill container","isCorrect":true},{"id":2,"text":"False - gases keep fixed volume","isCorrect":false},{"id":3,"text":"Only liquids expand freely","isCorrect":false},{"id":4,"text":"Solids fill containers","isCorrect":false}],"explanation":"Gases expand to fill containers.","difficulty":"BASIC"},
  {"id":"s_che_mat_2","domain":"CHEMISTRY","text":"Melting an ice cube is a physical change?","options":[{"id":1,"text":"True - molecules stay water","isCorrect":true},{"id":2,"text":"False - new substance forms","isCorrect":false},{"id":3,"text":"True only with salt","isCorrect":false},{"id":4,"text":"False - it becomes gas directly","isCorrect":false}],"explanation":"State changes keep molecular identity.","difficulty":"BASIC"},
  {"id":"s_che_ele_1","domain":"CHEMISTRY","text":"A mixture is a physical combination, not a chemical bond?","options":[{"id":1,"text":"True - separable without reaction","isCorrect":true},{"id":2,"text":"False - mixtures are bonded","isCorrect":false},{"id":3,"text":"True only for gases","isCorrect":false},{"id":4,"text":"False - compounds are mixtures","isCorrect":false}],"explanation":"Compounds bond; mixtures just mix.","difficulty":"BASIC"},
  {"id":"s_che_ele_2","domain":"CHEMISTRY","text":"Table salt forms from sodium and chlorine by?","options":[{"id":1,"text":"Chemical bonding into a compound","isCorrect":true},{"id":2,"text":"Physical mixing","isCorrect":false},{"id":3,"text":"Nuclear fusion","isCorrect":false},{"id":4,"text":"Evaporation","isCorrect":false}],"explanation":"Na + Cl bond into safe crystals.","difficulty":"BASIC"},
  {"id":"s_che_ato_1","domain":"CHEMISTRY","text":"The nucleus holds protons and neutrons?","options":[{"id":1,"text":"True - dense central core","isCorrect":true},{"id":2,"text":"False - electrons live there","isCorrect":false},{"id":3,"text":"True - plus orbiting protons","isCorrect":false},{"id":4,"text":"False - nucleus is empty","isCorrect":false}],"explanation":"Protons + neutrons form the nucleus.","difficulty":"BASIC"},
  {"id":"s_che_ato_2","domain":"CHEMISTRY","text":"Carbon always has how many protons?","options":[{"id":1,"text":"Six","isCorrect":true},{"id":2,"text":"Twelve","isCorrect":false},{"id":3,"text":"One","isCorrect":false},{"id":4,"text":"It varies","isCorrect":false}],"explanation":"Proton count defines the element.","difficulty":"INTERMEDIATE"},
  {"id":"s_che_rea_1","domain":"CHEMISTRY","text":"Burning paper turning to ash and smoke is a chemical change?","options":[{"id":1,"text":"True - brand-new substances form","isCorrect":true},{"id":2,"text":"False - it is still paper","isCorrect":false},{"id":3,"text":"True only with wind","isCorrect":false},{"id":4,"text":"False - burning is physical","isCorrect":false}],"explanation":"Ash and smoke never were paper.","difficulty":"BASIC"},
  {"id":"s_che_rea_2","domain":"CHEMISTRY","text":"Which sign suggests a chemical reaction occurred?","options":[{"id":1,"text":"Bubbles of new gas forming","isCorrect":true},{"id":2,"text":"Ice melting in a glass","isCorrect":false},{"id":3,"text":"Paper torn in half","isCorrect":false},{"id":4,"text":"Water poured in a bowl","isCorrect":false}],"explanation":"New gas means new substance.","difficulty":"BASIC"},
  {"id":"s_che_aci_1","domain":"CHEMISTRY","text":"Bases taste bitter and turn red litmus blue?","options":[{"id":1,"text":"True - opposite of acids","isCorrect":true},{"id":2,"text":"False - that describes acids","isCorrect":false},{"id":3,"text":"True only for soaps","isCorrect":false},{"id":4,"text":"False - bases turn blue red","isCorrect":false}],"explanation":"Acids sour/red; bases bitter/blue.","difficulty":"BASIC"},
  {"id":"s_che_aci_2","domain":"CHEMISTRY","text":"Acid plus base in right amounts gives?","options":[{"id":1,"text":"Water and salt","isCorrect":true},{"id":2,"text":"Only oxygen","isCorrect":false},{"id":3,"text":"Stronger acid","isCorrect":false},{"id":4,"text":"Hydrogen gas","isCorrect":false}],"explanation":"Neutralization yields water + salt.","difficulty":"INTERMEDIATE"},
  {"id":"s_che_qua_1","domain":"CHEMISTRY","text":"In quantum theory electrons live in probability clouds called?","options":[{"id":1,"text":"Orbitals","isCorrect":true},{"id":2,"text":"Fixed planetary orbits","isCorrect":false},{"id":3,"text":"Nucleus shells of stone","isCorrect":false},{"id":4,"text":"Magnetic bottles","isCorrect":false}],"explanation":"Orbitals map where electrons likely are.","difficulty":"INTERMEDIATE"},
  {"id":"s_che_qua_2","domain":"CHEMISTRY","text":"Heisenberg's principle limits knowing both position and?","options":[{"id":1,"text":"Speed of the electron","isCorrect":true},{"id":2,"text":"Charge of the electron","isCorrect":false},{"id":3,"text":"Color of the electron","isCorrect":false},{"id":4,"text":"Age of the electron","isCorrect":false}],"explanation":"Position and momentum can't both be exact.","difficulty":"ADVANCED"},
  {"id":"s_che_per_1","domain":"CHEMISTRY","text":"Electronegativity generally increases left to right across a period?","options":[{"id":1,"text":"True - except noble gases","isCorrect":true},{"id":2,"text":"False - it decreases","isCorrect":false},{"id":3,"text":"True only downwards","isCorrect":false},{"id":4,"text":"False - it stays constant","isCorrect":false}],"explanation":"Fluorine pulls hardest; noble gases ~zero.","difficulty":"INTERMEDIATE"},
  {"id":"s_che_per_2","domain":"CHEMISTRY","text":"Most elements on the left of the table are?","options":[{"id":1,"text":"Metals - shiny conductors","isCorrect":true},{"id":2,"text":"Gases - invisible fillers","isCorrect":false},{"id":3,"text":"Noble gases - non-reactive","isCorrect":false},{"id":4,"text":"Plasmas - charged clouds","isCorrect":false}],"explanation":"Left side hosts conductive metals.","difficulty":"BASIC"},
  {"id":"s_che_bon_1","domain":"CHEMISTRY","text":"Ionic bonds form by electron transfer between atoms?","options":[{"id":1,"text":"True - creates attracting ions","isCorrect":true},{"id":2,"text":"False - by equal sharing","isCorrect":false},{"id":3,"text":"True only in water","isCorrect":false},{"id":4,"text":"False - by neutron trade","isCorrect":false}],"explanation":"Sharing gives covalent bonds instead.","difficulty":"INTERMEDIATE"},
  {"id":"s_che_bon_2","domain":"CHEMISTRY","text":"Metals bend without breaking because of?","options":[{"id":1,"text":"Free-flowing electron sea","isCorrect":true},{"id":2,"text":"Rigid covalent nets","isCorrect":false},{"id":3,"text":"Ionic crystal locks","isCorrect":false},{"id":4,"text":"Wooden fiber cores","isCorrect":false}],"explanation":"Delocalized electrons let metals deform.","difficulty":"BASIC"},
  {"id":"s_che_elc_1","domain":"CHEMISTRY","text":"Rechargeable batteries store energy using?","options":[{"id":1,"text":"Reversible redox reactions","isCorrect":true},{"id":2,"text":"Melting electrodes","isCorrect":false},{"id":3,"text":"Burning fuel inside","isCorrect":false},{"id":4,"text":"Trapped lightning","isCorrect":false}],"explanation":"Galvanic cells run redox both ways.","difficulty":"INTERMEDIATE"},
  {"id":"s_che_org_1","domain":"CHEMISTRY","text":"Isomers share a formula but differ in?","options":[{"id":1,"text":"Arrangement of atoms","isCorrect":true},{"id":2,"text":"Number of protons","isCorrect":false},{"id":3,"text":"Total mass","isCorrect":false},{"id":4,"text":"Element types","isCorrect":false}],"explanation":"Same parts, different layout, different behavior.","difficulty":"INTERMEDIATE"},
  {"id":"s_che_thm_1","domain":"CHEMISTRY","text":"Burning wood warming a room is exothermic?","options":[{"id":1,"text":"True - releases heat","isCorrect":true},{"id":2,"text":"False - absorbs heat","isCorrect":false},{"id":3,"text":"True only outdoors","isCorrect":false},{"id":4,"text":"False - no energy involved","isCorrect":false}],"explanation":"Exothermic reactions give off heat.","difficulty":"BASIC"},
  {"id":"s_che_env_1","domain":"CHEMISTRY","text":"Acid rain mainly comes from sulfur emissions?","options":[{"id":1,"text":"True - damages forests","isCorrect":true},{"id":2,"text":"False - from clean rain","isCorrect":false},{"id":3,"text":"True only in deserts","isCorrect":false},{"id":4,"text":"False - rain is never acidic","isCorrect":false}],"explanation":"Sulfur gases acidify rainfall.","difficulty":"BASIC"},
  {"id":"s_bio_cel_1","domain":"BIOLOGY","text":"Plant cells have a rigid cell wall for structure?","options":[{"id":1,"text":"True - animal cells lack it","isCorrect":true},{"id":2,"text":"False - only animals have walls","isCorrect":false},{"id":3,"text":"Chloroplasts form the wall","isCorrect":false},{"id":4,"text":"Mitochondria form the wall","isCorrect":false}],"explanation":"Walls support plants against wind.","difficulty":"BASIC"},
  {"id":"s_bio_cel_2","domain":"BIOLOGY","text":"Which organelle is the cell's control center holding DNA?","options":[{"id":1,"text":"Nucleus","isCorrect":true},{"id":2,"text":"Ribosome","isCorrect":false},{"id":3,"text":"Lysosome","isCorrect":false},{"id":4,"text":"Vacuole","isCorrect":false}],"explanation":"Nucleus stores master plans.","difficulty":"BASIC"},
  {"id":"s_bio_tis_1","domain":"BIOLOGY","text":"Phloem transports food made in leaves to the plant?","options":[{"id":1,"text":"True - xylem carries water","isCorrect":true},{"id":2,"text":"False - phloem carries water","isCorrect":false},{"id":3,"text":"True only at night","isCorrect":false},{"id":4,"text":"False - leaves eat roots","isCorrect":false}],"explanation":"Two tissues split water and food duties.","difficulty":"BASIC"},
  {"id":"s_bio_tis_2","domain":"BIOLOGY","text":"Muscle tissue's job is to?","options":[{"id":1,"text":"Pull and stretch for movement","isCorrect":true},{"id":2,"text":"Send electrical messages","isCorrect":false},{"id":3,"text":"Cover skin surfaces","isCorrect":false},{"id":4,"text":"Make blood cells","isCorrect":false}],"explanation":"Nervous tissue sends messages instead.","difficulty":"BASIC"},
  {"id":"s_bio_nut_1","domain":"BIOLOGY","text":"Photosynthesis occurs in chloroplasts?","options":[{"id":1,"text":"True - green solar panels","isCorrect":true},{"id":2,"text":"False - in mitochondria","isCorrect":false},{"id":3,"text":"True only at night","isCorrect":false},{"id":4,"text":"False - in the nucleus","isCorrect":false}],"explanation":"Chloroplasts trap sunlight for food.","difficulty":"BASIC"},
  {"id":"s_bio_nut_2","domain":"BIOLOGY","text":"Humans make their own food from sunlight like plants?","options":[{"id":1,"text":"False - we are heterotrophs","isCorrect":true},{"id":2,"text":"True - we photosynthesize","isCorrect":false},{"id":3,"text":"True with enough water","isCorrect":false},{"id":4,"text":"False - plants eat us","isCorrect":false}],"explanation":"We must eat plants or animals.","difficulty":"BASIC"},
  {"id":"s_bio_res_1","domain":"BIOLOGY","text":"Cellular respiration happens mainly in mitochondria making ATP?","options":[{"id":1,"text":"True - powerhouse of cell","isCorrect":true},{"id":2,"text":"False - in chloroplasts","isCorrect":false},{"id":3,"text":"True only while running","isCorrect":false},{"id":4,"text":"False - in the nucleus","isCorrect":false}],"explanation":"Mitochondria burn sugar for energy.","difficulty":"BASIC"},
  {"id":"s_bio_res_2","domain":"BIOLOGY","text":"Red blood cells carry oxygen using?","options":[{"id":1,"text":"Hemoglobin","isCorrect":true},{"id":2,"text":"Chlorophyll","isCorrect":false},{"id":3,"text":"Insulin","isCorrect":false},{"id":4,"text":"Keratin","isCorrect":false}],"explanation":"Hemoglobin loads oxygen in lungs.","difficulty":"INTERMEDIATE"},
  {"id":"s_bio_rep_1","domain":"BIOLOGY","text":"DNA replication is semi-conservative?","options":[{"id":1,"text":"True - one old, one new strand","isCorrect":true},{"id":2,"text":"False - both strands brand new","isCorrect":false},{"id":3,"text":"True only in plants","isCorrect":false},{"id":4,"text":"False - DNA never copies","isCorrect":false}],"explanation":"Preserves genetic information.","difficulty":"INTERMEDIATE"},
  {"id":"s_bio_rep_2","domain":"BIOLOGY","text":"Meiosis produces four genetically unique haploid cells?","options":[{"id":1,"text":"True - sperm and egg variety","isCorrect":true},{"id":2,"text":"False - two identical cells","isCorrect":false},{"id":3,"text":"True only in bacteria","isCorrect":false},{"id":4,"text":"False - it makes no cells","isCorrect":false}],"explanation":"Shuffling creates diversity.","difficulty":"ADVANCED"},
  {"id":"s_bio_hor_1","domain":"BIOLOGY","text":"Hormones travel through blood to target organs?","options":[{"id":1,"text":"True - endocrine messengers","isCorrect":true},{"id":2,"text":"False - through nerves only","isCorrect":false},{"id":3,"text":"True only in plants","isCorrect":false},{"id":4,"text":"False - they never travel","isCorrect":false}],"explanation":"Glands release them into blood.","difficulty":"BASIC"},
  {"id":"s_bio_hor_2","domain":"BIOLOGY","text":"Insulin controls blood sugar and comes from the?","options":[{"id":1,"text":"Pancreas","isCorrect":true},{"id":2,"text":"Liver","isCorrect":false},{"id":3,"text":"Kidney","isCorrect":false},{"id":4,"text":"Heart","isCorrect":false}],"explanation":"Pancreas balances glucose.","difficulty":"INTERMEDIATE"},
  {"id":"s_bio_ner_1","domain":"BIOLOGY","text":"Reflex actions are slow conscious brain decisions?","options":[{"id":1,"text":"False - rapid spinal responses","isCorrect":true},{"id":2,"text":"True - always deliberate","isCorrect":false},{"id":3,"text":"Happen only in sleep","isCorrect":false},{"id":4,"text":"Decided by muscles","isCorrect":false}],"explanation":"Reflexes bypass conscious thought.","difficulty":"BASIC"},
  {"id":"s_bio_ner_2","domain":"BIOLOGY","text":"Neurons talk across tiny gaps called?","options":[{"id":1,"text":"Synapses","isCorrect":true},{"id":2,"text":"Tendons","isCorrect":false},{"id":3,"text":"Villi","isCorrect":false},{"id":4,"text":"Alveoli","isCorrect":false}],"explanation":"Neurotransmitters jump synapses.","difficulty":"INTERMEDIATE"},
  {"id":"s_bio_eco_1","domain":"BIOLOGY","text":"In a food chain energy flows producers to consumers?","options":[{"id":1,"text":"True - plants first","isCorrect":true},{"id":2,"text":"False - consumers first","isCorrect":false},{"id":3,"text":"Energy flows both ways equally","isCorrect":false},{"id":4,"text":"Decomposers start chains","isCorrect":false}],"explanation":"Producers capture sunlight first.","difficulty":"BASIC"},
  {"id":"s_bio_eco_2","domain":"BIOLOGY","text":"Why are top predators fewer than plants?","options":[{"id":1,"text":"Energy lost as heat each level","isCorrect":true},{"id":2,"text":"Predators reproduce faster","isCorrect":false},{"id":3,"text":"Plants eat predators","isCorrect":false},{"id":4,"text":"No reason - random","isCorrect":false}],"explanation":"Only ~10% transfers upward.","difficulty":"INTERMEDIATE"},
  {"id":"s_bio_gen_1","domain":"BIOLOGY","text":"CRISPR can snip faulty genes to treat disease?","options":[{"id":1,"text":"True - precise gene editing","isCorrect":true},{"id":2,"text":"False - cuts only paper","isCorrect":false},{"id":3,"text":"True only in crops","isCorrect":false},{"id":4,"text":"False - genes can't be edited","isCorrect":false}],"explanation":"CRISPR targets exact DNA spots.","difficulty":"ADVANCED"},
  {"id":"s_bio_mic_1","domain":"BIOLOGY","text":"Antibiotics kill viruses like flu?","options":[{"id":1,"text":"False - bacteria only","isCorrect":true},{"id":2,"text":"True - kills everything","isCorrect":false},{"id":3,"text":"True with high dose","isCorrect":false},{"id":4,"text":"False - kills nothing","isCorrect":false}],"explanation":"Overuse breeds superbugs.","difficulty":"BASIC"},
  {"id":"s_bio_phy_1","domain":"BIOLOGY","text":"Kidneys filter about how much daily?","options":[{"id":1,"text":"Around 180 liters","isCorrect":true},{"id":2,"text":"Around 2 liters","isCorrect":false},{"id":3,"text":"Around 1 liter","isCorrect":false},{"id":4,"text":"Nothing - skin filters","isCorrect":false}],"explanation":"Huge filtration keeps balance.","difficulty":"INTERMEDIATE"},
  {"id":"s_bio_bio_1","domain":"BIOLOGY","text":"PCR photocopies tiny DNA traces for tests?","options":[{"id":1,"text":"True - billions of copies","isCorrect":true},{"id":2,"text":"False - shrinks DNA","isCorrect":false},{"id":3,"text":"True only for fossils","isCorrect":false},{"id":4,"text":"False - PCR edits genes","isCorrect":false}],"explanation":"Copies enable detection.","difficulty":"INTERMEDIATE"},
  {"id":"s_ast_1","domain":"ASTRONOMY","text":"Light from Sun takes about 8 minutes to reach Earth?","options":[{"id":1,"text":"8 minutes - 150M km at light speed","isCorrect":true},{"id":2,"text":"Instant - no travel time","isCorrect":false},{"id":3,"text":"24 hours","isCorrect":false},{"id":4,"text":"1 year","isCorrect":false}],"explanation":"1 AU at c takes ~8 minutes.","difficulty":"BASIC"},
  {"id":"s_ast_2","domain":"ASTRONOMY","text":"Black holes trap even light inside the event horizon?","options":[{"id":1,"text":"True - point of no return","isCorrect":true},{"id":2,"text":"False - light escapes","isCorrect":false},{"id":3,"text":"Only radio escapes","isCorrect":false},{"id":4,"text":"Only X-rays escape","isCorrect":false}],"explanation":"Gravity beats light speed inside.","difficulty":"INTERMEDIATE"},
  {"id":"s_ast_3","domain":"ASTRONOMY","text":"Which planet is the Red Planet?","options":[{"id":1,"text":"Mars - iron-oxide dust","isCorrect":true},{"id":2,"text":"Venus - thick clouds","isCorrect":false},{"id":3,"text":"Jupiter - gas giant","isCorrect":false},{"id":4,"text":"Mercury - nearest Sun","isCorrect":false}],"explanation":"Rusty dust paints Mars red.","difficulty":"BASIC"},
  {"id":"s_ast_4","domain":"ASTRONOMY","text":"A light-year measures?","options":[{"id":1,"text":"Distance light travels in a year","isCorrect":true},{"id":2,"text":"Time for one orbit","isCorrect":false},{"id":3,"text":"Brightness of stars","isCorrect":false},{"id":4,"text":"Age of the universe","isCorrect":false}],"explanation":"It's a distance unit.","difficulty":"BASIC"},
  {"id":"s_geo_1","domain":"GEOLOGY","text":"Earth's crust is divided into moving tectonic plates?","options":[{"id":1,"text":"True - drift builds mountains","isCorrect":true},{"id":2,"text":"False - single fixed shell","isCorrect":false},{"id":3,"text":"Only the mantle moves","isCorrect":false},{"id":4,"text":"Plates melted away","isCorrect":false}],"explanation":"Plate motion drives quakes.","difficulty":"BASIC"},
