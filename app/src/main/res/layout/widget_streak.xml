<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0E"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAK"
            android:textColor="#FFF3E0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:contentDescription="Streak label" />

        <TextView
            android:id="@+id/streak_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🔥 0"
            android:textColor="#FFF3E0"
            android:textSize="58sp"
            android:textStyle="bold"
            android:contentDescription="Current streak" />
    </LinearLayout>
</FrameLayout>
