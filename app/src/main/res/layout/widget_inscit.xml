<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0E"
    android:padding="10dp">

    <android.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="2"
        android:rowCount="2">

        <!-- Streak card (bento large) -->
        <LinearLayout
            android:id="@+id/card_streak"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:background="@drawable/widget_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/streak_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 0"
                android:textColor="#FFF3E0"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="STREAK"
                android:textColor="#FFF3E0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Daily challenge calendar (bento large, dominant) -->
        <LinearLayout
            android:id="@+id/card_calendar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:background="@drawable/widget_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/cal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY CHALLENGE"
                android:textColor="#FFF3E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/days_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/cd0" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:text="M" android:textColor="#0A0B0E" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/cd1" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:text="T" android:textColor="#0A0B0E" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/cd2" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:text="W" android:textColor="#0A0B0E" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/cd3" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:text="T" android:textColor="#0A0B0E" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/cd4" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:text="F" android:textColor="#0A0B0E" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/cd5" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:text="S" android:textColor="#0A0B0E" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/cd6" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:text="S" android:textColor="#0A0B0E" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/cal_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="0/7 days"
                android:textColor="#FFF3E0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Goals card (bento small) -->
        <LinearLayout
            android:id="@+id/card_goals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:background="@drawable/widget_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/goals_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOALS"
                android:textColor="#FFF3E0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/goals_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="0/0"
                android:textColor="#FFF3E0"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rank / XP card (bento small) -->
        <LinearLayout
            android:id="@+id/card_rank"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:background="@drawable/widget_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/rank_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Beginner"
                android:textColor="#FFF3E0"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/xp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="XP 0  Lvl 1"
                android:textColor="#FFF3E0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/last_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Last 0%"
                android:textColor="#FFF3E0"
                android:textSize="12sp" />
        </LinearLayout>

    </android.widget.GridLayout>
</FrameLayout>
