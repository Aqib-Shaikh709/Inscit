<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020408"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Heading at the top, full width -->
        <TextView
            android:id="@+id/cal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="DAILY CHALLENGE"
            android:textColor="#00F2FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:contentDescription="Daily challenge heading" />

        <!-- Day circles spread across the X axis -->
        <LinearLayout
            android:id="@+id/days_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cd0"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="M"
                android:textColor="#F8F9FA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Monday" />
            <TextView
                android:id="@+id/cd1"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="T"
                android:textColor="#F8F9FA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Tuesday" />
            <TextView
                android:id="@+id/cd2"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="W"
                android:textColor="#F8F9FA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Wednesday" />
            <TextView
                android:id="@+id/cd3"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="T"
                android:textColor="#F8F9FA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Thursday" />
            <TextView
                android:id="@+id/cd4"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="F"
                android:textColor="#F8F9FA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Friday" />
            <TextView
                android:id="@+id/cd5"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="S"
                android:textColor="#F8F9FA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Saturday" />
            <TextView
                android:id="@+id/cd6"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="S"
                android:textColor="#F8F9FA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Sunday" />
        </LinearLayout>

        <TextView
            android:id="@+id/cal_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="0/7 days"
            android:textColor="#F8F9FA"
            android:textSize="15sp"
            android:contentDescription="Challenge progress" />
    </LinearLayout>
</FrameLayout>
