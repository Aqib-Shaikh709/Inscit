<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0E"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/rank_value"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="Current rank icon" />

        <TextView
            android:id="@+id/rank_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Beginner"
            android:textColor="#FFF3E0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/xp_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="XP 0  Lvl 1"
            android:textColor="#FFF3E0"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/last_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Last 0%"
            android:textColor="#FFF3E0"
            android:textSize="20sp"
            android:contentDescription="Last quiz score" />
    </LinearLayout>
</FrameLayout>
